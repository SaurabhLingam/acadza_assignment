  "level": "MEDIUM",
  "error": 1,
  "updatedAt": "2026-01-30T16:05:44.859Z",
  "scq": {
   "question": "<h3>Light of wavelength 4000 <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mover><mrow><mi> A </mi></mrow><mrow><mo>∘</mo></mrow></mover></mrow></math> falls on a metal surface. What is the stopping potential?</h3>\n\n<h3><math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo stretchy=\"false\">(A)</mo></mrow></math> 3.1 V<br />\n<mspace linebreak=\"newline\"> <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo stretchy=\"false\">(B)</mo></mrow></math> 2.0 V<br />\n<mspace linebreak=\"newline\"> <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo stretchy=\"false\">(C)</mo></mrow></math> 5.1 V<br />\n<mspace linebreak=\"newline\"> <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo stretchy=\"false\">(D)</mo></mrow></math> 1.1 V</mspace></mspace></mspace></h3>\n<mspace linebreak=\"newline\"></mspace>",
   "solution": "<h3>Energy of incident photon <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mi> h </mi><mi> c </mi></mrow><mrow><mi> &lambda; </mi></mrow></mfrac></mrow></math> = <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mn> 12400 </mn></mrow><mrow><mi> &lambda; </mi></mrow></mfrac></mrow></math> = <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mn> 12400 </mn></mrow><mrow><mn> 4000 </mn></mrow></mfrac></mrow></math> eV = 3.1eV <math display=\"inline\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><msub><mi> k </mi><mrow><mi> m </mi><mi> a </mi><mi> x </mi></mrow></msub></mrow></math> = h&nu; - &phi; = 3.1eV - 2.0eV = 1.1eV Hence, stopping potential 1.1 V</h3>\n",
   "answer": "D",
   "quesImages": [],
   "solutionImages": []
  },
  "errorHistory": []
 },
